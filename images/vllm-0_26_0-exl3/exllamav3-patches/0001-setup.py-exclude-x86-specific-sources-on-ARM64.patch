From 00d97da512923e36f2e99af53406c53b70eb8139 Mon Sep 17 00:00:00 2001
From: ARM64 Port <arm64@local>
Date: Tue, 11 Aug 2026 22:15:12 +0300
Subject: [PATCH 1/5] setup.py: exclude x86-specific sources on ARM64

---
 setup.py | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/setup.py b/setup.py
index ae33064..5c55928 100644
--- a/setup.py
+++ b/setup.py
@@ -55,11 +55,22 @@ extra_compile_args = {
 
 library_dir = "exllamav3"
 sources_dir = os.path.join(library_dir, extension_name)
+# On ARM64, exclude x86-specific source files
+import platform
+_is_arm = platform.machine() in ('aarch64', 'arm64')
+_x86_exclude = {
+    'avx2_target.cpp', 'avx512_target.cpp',
+    'all_reduce_cpu_avx2.cpp', 'all_reduce_cpu_avx512.cpp',
+    'moe_mul1.cpp', 'moe_handoff.cu',
+    'all_reduce_cpu.cu',
+} if _is_arm else set()
+
 sources = [
     os.path.relpath(os.path.join(root, file), start=os.path.dirname(__file__))
     for root, _, files in os.walk(sources_dir)
     for file in files
     if file.endswith(('.c', '.cpp', '.cu'))
+    and file not in _x86_exclude
 ]
 
 print (sources)
